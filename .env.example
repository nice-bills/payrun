# console.openserv.ai → API keys. Also enable data collection under Settings → Organization (hackathon rule).
SERV_API_KEY=
# portal.cdp.coinbase.com → API keys + wallet secret
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Filled after the first `npm run cli -- wallet address`
PAYRUN_WALLET_ADDRESS=
# Testnet settles invoices at this disclosed scale (0.001 → a 4,200 USDC invoice moves 4.2 test USDC)
PAYRUN_SETTLEMENT_SCALE=0.001
# Record every live SERV response to fixtures/cassettes and replay it for free next time (off|record|replay|auto)
PAYRUN_SERV_CASSETTE=auto
# Small model SERV runs the policy on (the raw control uses the same one)
PAYRUN_MODEL=gpt-6-luna
# Scam Payrun board that outlives the container: an Upstash Redis REST endpoint (Vercel KV's KV_REST_API_URL/TOKEN work too).
# Set on the OpenServ container (npm run openserv:build copies it) and on Vercel, so /arena reads it directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# House red team (npm run cli -- redteam --go): a CDP account on Base mainnet holding a little USDC for entry fees
PAYRUN_REDTEAM_WALLET=
# Vision model on SERV for photographed/scanned invoices (defaults to PAYRUN_MODEL)
PAYRUN_VISION_MODEL=
