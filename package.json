{
  "name": "payrun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "demo:replay": "PAYRUN_DB=data/replay.db PAYRUN_SERV_CASSETTE=replay PAYRUN_MODEL=gpt-6-luna sh -c 'rm -f data/replay.db && npm run -s cli -- init && npm run -s cli -- ingest && npm run -s cli -- run'",
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "demo:snapshot": "tsx scripts/demo-snapshot.ts",
    "demo:serve": "PAYRUN_DEMO=1 next dev --port 3200",
    "openserv": "tsx openserv/agent.ts",
    "openserv:build": "tsx scripts/build-openserv.mts",
    "openserv:deploy": "npm run openserv:build && tsx scripts/deploy-openserv.mts"
  },
  "dependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@coinbase/cdp-sdk": "^1.56.0",
    "@openserv-labs/client": "^2.5.3",
    "@openserv-labs/sdk": "^2.4.1",
    "dotenv": "^18.0.3",
    "graphql": "^17.0.2",
    "motion": "^13.4.2",
    "next": "^16.3.6",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}
